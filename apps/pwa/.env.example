# Base URL of the real API (only used when VITE_API_MOCK=false).
VITE_API_BASE_URL=http://localhost:3000/v1

# Mock mode is ON by default: src/api/client.ts returns realistic fake data instead of making
# network requests, so screens can be built before the backend (feature/db-schema-v2 and
# downstream branches) lands. Set to "false" to point the app at a real running apps/api.
# feature/pwa-api-integration flips this off for good once the real API is stable end-to-end.
VITE_API_MOCK=true
