{
  "name": "arca-billing-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:precio-base": "tsx --env-file=.env scripts/seed-precio-base.ts"
  },
  "dependencies": {
    "@arcasdk/core": "^1.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "argon2": "^0.40.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.0",
    "fastify-type-provider-zod": "^2.0.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^10.10.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
