# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arca_billing

# Application
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Encryption key for tenant certificates (32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-key-here-replace-this-value

# ARCA SDK mode (homologacion | produccion)
ARCA_MODE=homologacion

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
