# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arca_billing

# Application
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Encryption key for tenant certificates (32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-key-here-replace-this-value


# Secret used to sign/verify access token JWTs (min 32 chars).
# Generate with: openssl rand -base64 48
JWT_SECRET=your-jwt-signing-secret-at-least-32-chars-long

# ARCA SDK mode (homologacion | produccion)
ARCA_MODE=homologacion

NOTE: no ARCA_MODE here. ARCA environment (homologacion | produccion) is
# resolved per-usuario (usuarios.ambiente column), never a global env var —
# see apps/api/src/services/arca/index.ts.


# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
